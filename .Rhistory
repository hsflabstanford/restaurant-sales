library(arrow)
library(dplyr)
library(tidyr)
library(ggplot2)
library(gridExtra)
library(scales)
# Set working directory
setwd("C:/Users/Jared/Desktop/HSFL/restaurant-sales")
folder_path <- "C:/Users/Jared/Desktop/HSFL/restaurant-sales/palate_data_parquet/batch_1/orders_item_level"
# Read menu items using read_parquet
items_tagged <- read_parquet('palate_data_parquet/batch_1/items_tagged_v2_1.parquet')
# Select the first two files for comparison
files <- list.files(path = folder_path, pattern = "\\.parquet$", full.names = TRUE)
selected_files <- files[9:10]  # Adjusted to select files 9 and 10 as in the original code
# Process each file and summarize data
process_data <- function(file, items_tagged) {
df <- read_parquet(file)
merged_df <- merge(df, items_tagged, by = "item_name")
# Clean up the restaurant ID by removing the .parquet extension
restaurant_id <- gsub("\\.parquet$", "", basename(file))
restaurant_name <- paste("Restaurant", substr(restaurant_id, 1, 1))
# Summarize data by item type
summary <- merged_df %>%
group_by(item_type, is_plant_based) %>%
summarise(
total_sales = sum(item_price * item_quantity, na.rm = TRUE),
total_orders = sum(item_quantity, na.rm = TRUE),
.groups = 'drop'
) %>%
mutate(restaurant = restaurant_name)
return(summary)
}
# Summarize data for both restaurants
data_list <- lapply(selected_files, process_data, items_tagged = items_tagged)
# Combine the data
combined_data <- bind_rows(data_list)
combined_data <- combined_data %>% filter(item_type != "drink")
# Function to create a stacked bar plot with specified y-axis limits and labels
create_stacked_plot <- function(data, y, title, scale_limit = 1e10, scale_label_suffix = "B") {
y_label <- ifelse(y == "total_sales", "Total Sales", "Total Orders")
ggplot(data, aes(x = restaurant, y = {{y}}, fill = item_type)) +
geom_bar(stat = "identity", position = "stack") +
scale_y_continuous(limits = c(0, scale_limit),
labels = label_number(scale = 1 / 10^9, suffix = scale_label_suffix)) +
labs(title = title, x = "Restaurants", y = y_label) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
}
# Create the plots for sales
plot_sales_all <- create_stacked_plot(combined_data, total_sales, "Total Sales by Item Type")
