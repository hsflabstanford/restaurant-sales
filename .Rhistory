}
# Summarize data for both restaurants
data_list <- lapply(selected_files, process_data, items_tagged = items_tagged)
# Combine the data
combined_data <- bind_rows(data_list)
combined_data <- combined_data %>% filter(item_type != "drink")
# Function to create a stacked bar plot
create_stacked_plot <- function(data, y, title) {
ggplot(data, aes(x = restaurant, y = {{y}}, fill = item_type)) +
geom_bar(stat = "identity", position = "stack") +
scale_y_continuous(limits = c(0, 1e10), labels = label_number(scale = 1e-6, suffix = "M")) +
labs(title = title, y = deparse(substitute(y))) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
}
# Create the plots
plot_sales_all <- create_stacked_plot(combined_data, total_sales, "Total Sales by Item Type")
plot_orders_all <- create_stacked_plot(combined_data, total_orders, "Total Orders by Item Type")
combined_data_plant <- combined_data %>% filter(is_plant_based == "yes")
plot_sales_plant <- create_stacked_plot(combined_data_plant, total_sales, "Total Sales by Item Type (Plant-Based)")
plot_orders_plant <- create_stacked_plot(combined_data_plant, total_orders, "Total Orders by Item Type (Plant-Based)")
# Arrange the plots in a 2x2 grid
plot_grid <- grid.arrange(plot_sales_all, plot_sales_plant, plot_orders_all, plot_orders_plant, ncol = 2)
