scale_divider <- 1e5
}
ggplot(data, aes(x = restaurant, y = {{y}}, fill = item_type)) +
geom_bar(stat = "identity", position = "stack") +
scale_y_continuous(limits = c(0, scale_limit),
labels = label_number(scale = 1 / scale_divider, suffix = scale_label_suffix, prefix = money_prefix)) +
labs(title = title, x = "Restaurants", y = y_label) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
}
# Create the plots for sales
plot_sales_all <- create_stacked_plot(combined_data, total_sales, "Total Sales by Item Type")
plot_sales_plant <- create_stacked_plot(combined_data_plant, total_sales, "Total Sales (Plant-Based)")
# Create the plots for orders
plot_orders_all <- create_stacked_plot(combined_data, total_orders, "Total Orders by Item Type", sales = FALSE)
plot_orders_plant <- create_stacked_plot(combined_data_plant, total_orders, "Total Orders (Plant-Based)", sales = FALSE)
# Arrange the plots in a 2x2 grid
plot_grid <- grid.arrange(plot_sales_all, plot_sales_plant, plot_orders_all, plot_orders_plant, ncol = 2)
